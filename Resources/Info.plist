<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Assistant</string>
    <key>CFBundleDisplayName</key>
    <string>Assistant</string>
    <key>CFBundleIdentifier</key>
    <string>click.ciromaciel.voice-assistant</string>
    <key>CFBundleVersion</key>
    <string>__VERSION__</string>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>pt-BR</string>
    </array>
    <key>NSMicrophoneUsageDescription</key>
    <string>Assistant listens to you through the microphone to talk by voice. The audio stays on this Mac.</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleExecutable</key>
    <string>AssistantBar</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- macOS 26 and later keep every freed page for the app unless it starts with this: then
         freed memory goes back at once. Set here, by Launch Services, because a relaunch with
         exec to set it loses the menu bar icon. -->
    <key>LSEnvironment</key>
    <dict>
        <key>MallocSpaceEfficient</key>
        <string>1</string>
    </dict>
</dict>
</plist>
